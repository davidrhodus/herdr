+    #[test]
+    fn ascii_batches_preserve_scalar_dispatch_at_every_word_boundary() {
+        #[derive(Default)]
+        struct Batch {
+            events: Vec<(bool, char)>,
+            batches: usize,
+        }
+        impl Perform for Batch {
+            fn print(&mut self, c: char) {
+                self.events.push((true, c));
+            }
+            fn execute(&mut self, c: u8) {
+                self.events.push((false, char::from(c)));
+            }
+            fn print_ascii(&mut self, bytes: &[u8]) {
+                assert!(bytes.iter().all(|b| (0x20..=0x7e).contains(b)));
+                self.batches += 1;
+                for b in bytes {
+                    self.print(char::from(*b));
+                }
+            }
+        }
+        for offset in 0..24 {
+            for cp in 0..256 {
+                let text = format!(
+                    "{}{}{}界",
+                    " ".repeat(offset),
+                    char::from_u32(cp).unwrap(),
+                    "~".repeat(24)
+                );
+                let mut actual = Batch::default();
+                Parser::<1024>::ground_dispatch(&mut actual, &text);
+                let expected: Vec<_> = text
+                    .chars()
+                    .map(|c| (!matches!(c, '\x00'..='\x1f' | '\u{80}'..='\u{9f}'), c))
+                    .collect();
+                assert_eq!(actual.events, expected);
+                assert!(actual.batches > 0);
+            }
+        }
+    }
+    #[test]
+    fn bulk_csi_parameters_match_fragmented_controls_subparams_and_overflow() {
+        let cases = [
+            "\x1b[38;2;17;34;51mtext\x1b[0m",
+            "\x1b[38:2::17:34:51mcolon\x1b[4:3m",
+            "\x1b[9999999999999999999999999999;2Htail",
+            "\x1b[1;\x07;2Hbell\x1b[1;\x18cancelled",
+            "\x1b[;:1;;2:3;4m\x1b[0;1$pfinal",
+        ];
+        for input in cases.iter().map(|s| s.as_bytes().to_vec()).chain([format!(
+            "\x1b[{}moverflow",
