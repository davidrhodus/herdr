+    // Stay in the numeric state for a whole parameter run. No performer
+    // callbacks occur before its final/control byte, so parameters need no
+    // repeated general state dispatch or termination polling.
+    #[inline]
+    fn advance_csi_parameters<P: Perform>(&mut self, performer: &mut P, bytes: &[u8]) -> usize {
+        let mut param = self.param;
+        for (i, byte) in bytes.iter().copied().enumerate() {
+            match byte {
+                b'0'..=b'9' => {
+                    if self.params.is_full() {
+                        self.ignoring = true;
+                    } else {
+                        param = (u32::from(param) * 10 + u32::from(byte - b'0'))
+                            .min(u16::MAX as u32) as u16;
+                    }
+                }
+                b';' | b':' => {
+                    if self.params.is_full() {
+                        self.ignoring = true;
+                    } else {
+                        if byte == b';' {
+                            self.params.push(param);
+                        } else {
+                            self.params.extend(param);
+                        }
+                        param = 0;
+                    }
+                }
+                0x40..=0x7e => {
+                    self.param = param;
+                    self.action_csi_dispatch(performer, byte);
+                    return i + 1;
+                }
+                _ => {
+                    self.param = param;
+                    self.advance_csi_param(performer, byte);
+                    return i + 1;
+                }
+            }
+        }
+        self.param = param;
+        bytes.len()
     }

